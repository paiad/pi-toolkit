{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "noEmit": true,
    "types": ["node"],
    "allowImportingTsExtensions": true
  },
  "include": ["extensions/**/*.ts", "types/**/*.d.ts"],
  "exclude": ["extensions/pi-mcp-adapter/**", "extensions/pi-subagents/**"]
}
